# Copy to .env. Everything is optional; the offline fixtures need nothing.

# --- live scans (--provider rpc) --------------------------------------------
# Key-less public endpoints that serve eth_getLogs with usable block spans and honour
# eth_call state overrides (verified 2026-10). Binance's bsc-dataseed.* endpoints do NOT
# serve logs at all ("limit exceeded" for any span) and mainnet.base.org rate-limits
# aggressively; a free Alchemy/Infura/QuickNode key is better for anything sustained.
RUGSCAN_ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com
RUGSCAN_BSC_RPC_URL=https://bsc-rpc.publicnode.com
RUGSCAN_ARBITRUM_RPC_URL=https://arbitrum-one-rpc.publicnode.com
RUGSCAN_BASE_RPC_URL=https://base-rpc.publicnode.com
# Etherscan v2 key (one key covers all supported chains). Without it: no source
# verification, no deployer tracing – those heuristics report missing data.
RUGSCAN_ETHERSCAN_API_KEY=

# --- persistence ------------------------------------------------------------
# SQLite cache for snapshots, labels and report history (enables `history`,
# `label`, `backtest`, cached re-scans and prior-rug lookups).
RUGSCAN_CACHE_PATH=reports/rugscan.db
# Trained ML models are persisted here (default .rugscan/models). Empty = retrain each run.
RUGSCAN_MODEL_CACHE_DIR=.rugscan/models

# --- alerts (`watch`) -------------------------------------------------------
# Discord / Slack-compatible incoming webhook.
RUGSCAN_WEBHOOK_URL=

RUGSCAN_LOG_LEVEL=INFO
RUGSCAN_RPC_TIMEOUT_S=20
